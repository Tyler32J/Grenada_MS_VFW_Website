# Copy this file to .env.local for local development, and add the same two
# variables in Railway (service -> Variables).
# Find both in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# The "anon" / "publishable" key. This one is safe to expose in the browser.
# NEVER put the "service_role" / "secret" key here: it bypasses all security rules.
VITE_SUPABASE_ANON_KEY=your-anon-key
